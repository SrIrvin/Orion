<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Base Colors -->
    <Color x:Key="PrimaryPrussianBlue">#003153</Color>
    <Color x:Key="PrimaryPrussianBlueHover">#004B75</Color>
    <Color x:Key="PrimaryPrussianBluePressed">#00243A</Color>
    
    <Color x:Key="SecondarySteelBlue">#4682B4</Color>
    <Color x:Key="SecondarySteelBlueHover">#3A6E96</Color>
    <Color x:Key="SecondarySteelBluePressed">#2F5878</Color>
    
    <Color x:Key="AccentCoral">#FF6F61</Color>
    <Color x:Key="AccentCoralHover">#E85C50</Color>
    <Color x:Key="AccentCoralPressed">#C94B40</Color>
    
    <Color x:Key="BackgroundLight">#DCE3E8</Color>
    <Color x:Key="SurfaceWhite">#FFFFFF</Color>
    <Color x:Key="BorderGrey">#D0D7DE</Color>
    
    <Color x:Key="TextPrimary">#2F3A45</Color>
    <Color x:Key="TextSecondary">#5F6C76</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>
    <Color x:Key="TextDisabled">#A0A8AE</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryPrussianBlue}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondarySteelBlue}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentCoral}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundLight}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceWhite}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderGrey}"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimary}"/>

</ResourceDictionary>
