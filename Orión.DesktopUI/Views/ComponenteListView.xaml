<UserControl x:Class="Orión.DesktopUI.Views.ComponenteListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             Style="{StaticResource ViewEntranceAnimation}" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Command="{Binding DataContext.NavigateToMaquinariaCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,16,0">
                <materialDesign:PackIcon Kind="ArrowLeft"/>
            </Button>
            <TextBlock Text="DETALLE DE COMPONENTES" Style="{StaticResource MaterialDesignHeadline5TextBlock}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding MaquinariaId, StringFormat='(Máquina: {0})'}" 
                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}" 
                       VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource SecondaryBrush}"/>

            <TextBox Width="250" Margin="32,0,0,0"
                     materialDesign:HintAssist.Hint="Buscar componente..."
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding LoadComponentesCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Button Command="{Binding CreateComponenteCommand}" 
                    Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="16,0,0,0" ToolTip="Registrar Nuevo Componente">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0"/>
                    <TextBlock Text="NUEVO"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" VerticalAlignment="Top" 
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Componentes}" SelectedItem="{Binding SelectedComponente}" 
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Style="{StaticResource MaterialDesignDataGrid}"
                  materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdComponente}"/>
                <DataGridTextColumn Header="NOMBRE" Binding="{Binding NombreComponente}" Width="*"/>
                <DataGridTextColumn Header="TIPO" Binding="{Binding TipoComponenteNombre}"/>
                <DataGridTextColumn Header="ESTADO" Binding="{Binding EstadoDescripcion}"/>
                <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding ProveedorNombre}" Width="*"/>
                <DataGridTextColumn Header="ACTIVO" Binding="{Binding Activo}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Sí"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Activo}" Value="False">
                                    <Setter Property="Text" Value="No"/>
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <DataGridTemplateColumn Header="ACCIONES" Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding DataContext.EditComponenteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        Style="{StaticResource MaterialDesignIconButton}" ToolTip="Editar">
                                    <materialDesign:PackIcon Kind="Edit"/>
                                </Button>
                                <Button Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        Style="{StaticResource MaterialDesignIconButton}" ToolTip="Habilitar/Deshabilitar">
                                    <materialDesign:PackIcon>
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="Delete"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                        <Setter Property="Kind" Value="Restore"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

