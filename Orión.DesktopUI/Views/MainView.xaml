<Window x:Class="Orión.DesktopUI.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Orión.DesktopUI.Views"
        mc:Ignorable="d"
        Title="Orión - Gestor de Mantenimiento" Height="720" Width="1280"
        Icon="../Assets/Icono.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <materialDesign:DialogHost Identifier="MainDialogHost" SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}">
        <materialDesign:DrawerHost IsLeftDrawerOpen="{Binding ElementName=MenuToggleButton, Path=IsChecked}">
            <materialDesign:DrawerHost.LeftDrawerContent>
                <DockPanel Width="270">
                    <DockPanel.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#003153" Offset="0"/>
                            <GradientStop Color="#004B75" Offset="1"/>
                        </LinearGradientBrush>
                    </DockPanel.Background>
                    
                    <StackPanel DockPanel.Dock="Top" Margin="0,32,0,40">
                        <materialDesign:Card Width="100" Height="100" UniformCornerRadius="50" 
                                             Padding="0" Background="White" materialDesign:ElevationAssist.Elevation="Dp4"
                                             HorizontalAlignment="Center">
                            <Image Source="../Assets/Icono.PNG" Width="70" Height="70" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </materialDesign:Card>
                        <TextBlock Text="ORIÓN" HorizontalAlignment="Center" Margin="0,16,0,0" 
                                   FontSize="28" FontWeight="Black" Foreground="White" LetterSpacing="4"/>
                        <TextBlock Text="GESTOR DE MANTENIMIENTO" HorizontalAlignment="Center" 
                                   FontSize="11" Foreground="#A0A8AE" FontWeight="SemiBold" Opacity="0.8"/>
                    </StackPanel>
                    
                    <ListBox x:Name="DrawerListBox" Margin="0" 
                             SelectedIndex="0"
                             ItemContainerStyle="{StaticResource MaterialDesignNavigationListBoxItem}"
                             Style="{StaticResource MaterialDesignNavigationPrimaryListBox}"
                             Background="Transparent">
                        <ListBoxItem Foreground="White" Height="50">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToDashboardCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" Margin="24,0,20,0" VerticalAlignment="Center" Width="22" Height="22"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="16" FontWeight="Medium"/>
                            </StackPanel>
                        </ListBoxItem>
                        
                        <ListBoxItem Foreground="White" Height="50">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMaquinariaCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Engine" Margin="24,0,20,0" VerticalAlignment="Center" Width="22" Height="22"/>
                                <TextBlock Text="Maquinaria" VerticalAlignment="Center" FontSize="16" FontWeight="Medium"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Foreground="White" Height="50">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToTecnicosCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Margin="24,0,20,0" VerticalAlignment="Center" Width="22" Height="22"/>
                                <TextBlock Text="Personal" VerticalAlignment="Center" FontSize="16" FontWeight="Medium"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Foreground="White" Height="50">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToSolicitudesCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="HammerWrench" Margin="24,0,20,0" VerticalAlignment="Center" Width="22" Height="22"/>
                                <TextBlock Text="Solicitudes" VerticalAlignment="Center" FontSize="16" FontWeight="Medium"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Foreground="White" Height="50">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocument" Margin="24,0,20,0" VerticalAlignment="Center" Width="22" Height="22"/>
                                <TextBlock Text="Reportes" VerticalAlignment="Center" FontSize="16" FontWeight="Medium"/>
                            </StackPanel>
                        </ListBoxItem>
                        
                        <ListBoxItem Foreground="White" Height="50" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToUsuariosCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShieldAccount" Margin="24,0,20,0" VerticalAlignment="Center" Width="22" Height="22"/>
                                <TextBlock Text="Usuarios" VerticalAlignment="Center" FontSize="16" FontWeight="Medium"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,0,0,24">
                        <Separator Background="White" Margin="24,0,24,20" Opacity="0.2"/>
                        <ListBoxItem Foreground="White" Height="50">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Settings" Margin="24,0,20,0" VerticalAlignment="Center" Width="22" Height="22"/>
                                <TextBlock Text="Configuración" VerticalAlignment="Center" FontSize="16" FontWeight="Medium"/>
                            </StackPanel>
                        </ListBoxItem>
                    </StackPanel>
                </DockPanel>
            </materialDesign:DrawerHost.LeftDrawerContent>

            <DockPanel Background="{StaticResource BackgroundBrush}">
                <materialDesign:ColorZone Padding="8,16" materialDesign:ElevationAssist.Elevation="Dp2" 
                                          Mode="Standard" DockPanel.Dock="Top" Background="White">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <ToggleButton x:Name="MenuToggleButton" Style="{StaticResource MaterialDesignHamburgerToggleButton}"
                                          Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" FontSize="18" 
                                       Text="Orión - Sistema de Gestión" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <materialDesign:Chip Content="Sesión: Admin" Margin="8,0,16,0" 
                                                 IconBackground="{StaticResource PrimaryBrush}"
                                                 IconForeground="White">
                                <materialDesign:Chip.Icon>
                                    <materialDesign:PackIcon Kind="Account" />
                                </materialDesign:Chip.Icon>
                            </materialDesign:Chip>
                        </StackPanel>
                    </DockPanel>
                </materialDesign:ColorZone>

                <Grid Margin="24">
                    <ContentControl Content="{Binding CurrentView}"/>
                </Grid>
            </DockPanel>
        </materialDesign:DrawerHost>
    </materialDesign:DialogHost>
</Window>
