<Window x:Class="Orión.DesktopUI.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Orión.DesktopUI.Views"
        mc:Ignorable="d"
        Title="Orión - Gestor de Mantenimiento" Height="720" Width="1280"
        Icon="../Assets/Icono.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    
    <materialDesign:DrawerHost IsLeftDrawerOpen="{Binding ElementName=MenuToggleButton, Path=IsChecked}">
        <materialDesign:DrawerHost.LeftDrawerContent>
            <DockPanel Width="250" Background="{StaticResource PrimaryBrush}">
                <StackPanel DockPanel.Dock="Top" Margin="0,24,0,32">
                    <Image Source="../Assets/Icono.PNG" Width="64" Height="64" HorizontalAlignment="Center"/>
                    <TextBlock Text="ORIÓN" HorizontalAlignment="Center" Margin="0,8,0,0" 
                               FontSize="24" FontWeight="Black" Foreground="White"/>
                    <TextBlock Text="MANTENIMIENTO" HorizontalAlignment="Center" 
                               FontSize="10" Foreground="{StaticResource BorderBrush}"/>
                </StackPanel>
                
                <ListBox x:Name="DrawerListBox" Margin="0" 
                         SelectedIndex="0"
                         ItemContainerStyle="{StaticResource MaterialDesignNavigationListBoxItem}"
                         Style="{StaticResource MaterialDesignNavigationPrimaryListBox}"
                         Background="Transparent">
                    <ListBoxItem Foreground="White">
                        <ListBoxItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToDashboardCommand}"/>
                        </ListBoxItem.InputBindings>
                        <StackPanel Orientation="Horizontal" Height="40">
                            <materialDesign:PackIcon Kind="ViewDashboard" Margin="16,0,16,0" VerticalAlignment="Center" Width="24" Height="24"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                    </ListBoxItem>
                    
                    <ListBoxItem Foreground="White">
                        <ListBoxItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMaquinariaCommand}"/>
                        </ListBoxItem.InputBindings>
                        <StackPanel Orientation="Horizontal" Height="40">
                            <materialDesign:PackIcon Kind="Engine" Margin="16,0,16,0" VerticalAlignment="Center" Width="24" Height="24"/>
                            <TextBlock Text="Maquinaria" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Foreground="White">
                        <ListBoxItem.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToTecnicosCommand}"/>
                        </ListBoxItem.InputBindings>
                        <StackPanel Orientation="Horizontal" Height="40">
                            <materialDesign:PackIcon Kind="AccountGroup" Margin="16,0,16,0" VerticalAlignment="Center" Width="24" Height="24"/>
                            <TextBlock Text="Personal" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Foreground="White">
                        <StackPanel Orientation="Horizontal" Height="40">
                            <materialDesign:PackIcon Kind="FileDocument" Margin="16,0,16,0" VerticalAlignment="Center" Width="24" Height="24"/>
                            <TextBlock Text="Reportes" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="0,0,0,16">
                    <Separator Background="{StaticResource BorderBrush}" Margin="16,0,16,16" Opacity="0.3"/>
                    <ListBoxItem Foreground="White">
                        <StackPanel Orientation="Horizontal" Height="40">
                            <materialDesign:PackIcon Kind="Settings" Margin="16,0,16,0" VerticalAlignment="Center" Width="24" Height="24"/>
                            <TextBlock Text="Configuración" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                    </ListBoxItem>
                </StackPanel>
            </DockPanel>
        </materialDesign:DrawerHost.LeftDrawerContent>

        <DockPanel Background="{StaticResource BackgroundBrush}">
            <materialDesign:ColorZone Padding="8,16" materialDesign:ElevationAssist.Elevation="Dp2" 
                                      Mode="Standard" DockPanel.Dock="Top" Background="White">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <ToggleButton x:Name="MenuToggleButton" Style="{StaticResource MaterialDesignHamburgerToggleButton}"
                                      Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" FontSize="18" 
                                   Text="Maquinaria de Servicio" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource TextSecondaryBrush}">
                            <materialDesign:PackIcon Kind="BellOutline" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0">
                            <materialDesign:PackIcon Kind="HelpCircleOutline" />
                        </Button>
                        <materialDesign:Chip Content="Admin" Margin="8,0,16,0" 
                                             IconBackground="{StaticResource PrimaryBrush}"
                                             IconForeground="White">
                            <materialDesign:Chip.Icon>
                                <materialDesign:PackIcon Kind="Account" />
                            </materialDesign:Chip.Icon>
                        </materialDesign:Chip>
                    </StackPanel>
                </DockPanel>
            </materialDesign:ColorZone>

            <Grid Margin="24">
                <ContentControl Content="{Binding CurrentView}"/>
            </Grid>
        </DockPanel>
    </materialDesign:DrawerHost>
</Window>
