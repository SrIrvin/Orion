<Window x:Class="Orión.DesktopUI.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Orión.DesktopUI.Views"
        xmlns:converters="clr-namespace:Orión.DesktopUI.Converters"
        xmlns:helpers="clr-namespace:Orión.DesktopUI.Helpers"
        mc:Ignorable="d"
        Title="Orión - Gestor de Mantenimiento" Height="720" Width="1280"
        Icon="../Assets/Icono.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <converters:StringToUpperConverter x:Key="StringToUpperConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:StringToBooleanConverter x:Key="StringToBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="MainDialogHost" SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}">
        <materialDesign:DrawerHost IsLeftDrawerOpen="{Binding ElementName=MenuToggleButton, Path=IsChecked}">
            <materialDesign:DrawerHost.LeftDrawerContent>
                <Grid Width="280">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00243A" Offset="0"/>
                            <GradientStop Color="#003153" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Menu -->
                        <RowDefinition Height="Auto"/> <!-- Settings -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <StackPanel Grid.Row="0" Margin="0,40,0,40">
                        <materialDesign:Card Width="90" Height="90" UniformCornerRadius="45" 
                                             Padding="0" Background="White" materialDesign:ElevationAssist.Elevation="Dp3"
                                             HorizontalAlignment="Center">
                            <Image Source="../Assets/Icono.PNG" Width="60" Height="60" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </materialDesign:Card>
                        <TextBlock Text="ORIÓN" HorizontalAlignment="Center" Margin="0,16,0,0" 
                                   FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="SISTEMA DE GESTIÓN" HorizontalAlignment="Center" 
                                   FontSize="10" Foreground="#A0A8AE" FontWeight="Light" Opacity="0.7"/>
                    </StackPanel>
                    
                    <!-- MAIN MENU -->
                    <ListBox Grid.Row="1" x:Name="DrawerListBox" Margin="0" 
                             SelectedIndex="0"
                             ItemContainerStyle="{StaticResource MaterialDesignNavigationListBoxItem}"
                             Style="{StaticResource MaterialDesignNavigationPrimaryListBox}"
                             Background="Transparent">
                        
                        <ListBoxItem Foreground="White" Height="48">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToDashboardCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" Margin="24,0,20,0" VerticalAlignment="Center" Width="24" Height="24" Opacity="0.9"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="15" FontWeight="Normal"/>
                            </StackPanel>
                        </ListBoxItem>
                        
                        <ListBoxItem Foreground="White" Height="48">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMaquinariaCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Engine" Margin="24,0,20,0" VerticalAlignment="Center" Width="24" Height="24" Opacity="0.9"/>
                                <TextBlock Text="Maquinaria" VerticalAlignment="Center" FontSize="15" FontWeight="Normal"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Foreground="White" Height="48">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToTecnicosCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Margin="24,0,20,0" VerticalAlignment="Center" Width="24" Height="24" Opacity="0.9"/>
                                <TextBlock Text="Personal" VerticalAlignment="Center" FontSize="15" FontWeight="Normal"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Foreground="White" Height="48">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToSolicitudesCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="HammerWrench" Margin="24,0,20,0" VerticalAlignment="Center" Width="24" Height="24" Opacity="0.9"/>
                                <TextBlock Text="Solicitudes" VerticalAlignment="Center" FontSize="15" FontWeight="Normal"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Foreground="White" Height="48">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToProveedoresCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TruckDelivery" Margin="24,0,20,0" VerticalAlignment="Center" Width="24" Height="24" Opacity="0.9"/>
                                <TextBlock Text="Proveedores" VerticalAlignment="Center" FontSize="15" FontWeight="Normal"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Foreground="White" Height="48">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToReportesCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocument" Margin="24,0,20,0" VerticalAlignment="Center" Width="24" Height="24" Opacity="0.9"/>
                                <TextBlock Text="Reportes" VerticalAlignment="Center" FontSize="15" FontWeight="Normal"/>
                            </StackPanel>
                        </ListBoxItem>
                        
                        <ListBoxItem Foreground="White" Height="48" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToUsuariosCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShieldAccount" Margin="24,0,20,0" VerticalAlignment="Center" Width="24" Height="24" Opacity="0.9"/>
                                <TextBlock Text="Usuarios" VerticalAlignment="Center" FontSize="15" FontWeight="Normal"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- SETTINGS SECTION -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,16">
                        <Separator Background="White" Margin="20,0,20,8" Opacity="0.15"/>
                        
                        <materialDesign:PopupBox Style="{DynamicResource MaterialDesignPopupBox}"
                                                PlacementMode="RightAndAlignTopEdges"
                                                UnfurlOrientation="Horizontal"
                                                ToolTip="Configuración y Sesión"
                                                Foreground="White"
                                                Margin="24,0,20,0"
                                                HorizontalAlignment="Left">
                            <materialDesign:PopupBox.ToggleContent>
                                <StackPanel Orientation="Horizontal" Height="48">
                                    <materialDesign:PackIcon Kind="SettingsOutline" Width="24" Height="24" VerticalAlignment="Center" Opacity="0.9"/>
                                    <TextBlock Text="Configuración" VerticalAlignment="Center" FontSize="15" Margin="20,0,0,0" FontWeight="Normal"/>
                                </StackPanel>
                            </materialDesign:PopupBox.ToggleContent>
                            
                            <StackPanel Width="220">
                                <TextBlock Text="CONFIGURACIÓN" Margin="16,12,16,8" FontSize="10" FontWeight="Bold" Opacity="0.6"/>
                                
                                <Button Command="{Binding LogoutCommand}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" Margin="0,0,12,0"/>
                                        <TextBlock Text="Cerrar sesión"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding SwitchAccountCommand}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountSwitch" Width="20" Height="20" Margin="0,0,12,0"/>
                                        <TextBlock Text="Switch Account"/>
                                    </StackPanel>
                                </Button>
                                
                                <Separator Margin="8,4"/>

                                <TextBlock Text="SISTEMA DE DATOS" Margin="16,4,16,8" FontSize="10" FontWeight="Bold" Opacity="0.6"/>

                                <Button Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}" 
                                        Style="{StaticResource MaterialDesignFlatButton}" 
                                        HorizontalContentAlignment="Left" Padding="16,8">
                                    <Button.CommandParameter>
                                        <Grid Width="500" Margin="24">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="CONFIGURACIÓN DE BASE DE DATOS" 
                                                       FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                                            
                                            <Separator Grid.Row="1" Background="{DynamicResource PrimaryBrush}" Margin="0,0,0,20" Opacity="0.3"/>

                                            <!-- SELECTOR DE MOTOR -->
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                                                <RadioButton Content="Microsoft Access" Margin="0,0,32,0"
                                                             Style="{StaticResource MaterialDesignTabRadioButton}"
                                                             IsChecked="{Binding ConfigEditBuffer.Provider, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='Access'}"/>
                                                <RadioButton Content="PostgreSQL Server" 
                                                             Style="{StaticResource MaterialDesignTabRadioButton}"
                                                             IsChecked="{Binding ConfigEditBuffer.Provider, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='PostgreSQL'}"/>
                                            </StackPanel>

                                            <!-- CAMPOS DINÁMICOS -->
                                            <ScrollViewer Grid.Row="3" MaxHeight="350" VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <!-- Access Fields -->
                                                    <StackPanel Visibility="{Binding ConfigEditBuffer.Provider, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Access'}">
                                                        <TextBlock Text="📁 Ruta del archivo (.accdb / .mdb)" Margin="0,0,0,8" Opacity="0.6" FontSize="12"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding ConfigEditBuffer.AccessFilePath, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                                     materialDesign:HintAssist.Hint="C:\Ruta\BaseDeDatos.accdb"/>
                                                            <Button Grid.Column="1" Command="{Binding BrowseAccessFileCommand}"
                                                                    Style="{StaticResource MaterialDesignIconButton}" Margin="8,0,0,0">
                                                                <materialDesign:PackIcon Kind="FolderOpen" />
                                                            </Button>
                                                        </Grid>
                                                        <TextBlock Text="Requisito: Microsoft Access Database Engine 2016+ (X64)" 
                                                                   Margin="4,8,0,0" FontSize="11" Foreground="#FF6F61" Opacity="0.8"/>
                                                    </StackPanel>

                                                    <!-- PostgreSQL Fields -->
                                                    <StackPanel Visibility="{Binding ConfigEditBuffer.Provider, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='PostgreSQL'}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="100"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding ConfigEditBuffer.Host, UpdateSourceTrigger=PropertyChanged}"
                                                                     materialDesign:HintAssist.Hint="Host / Servidor" Margin="0,0,8,16"
                                                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                                                            <TextBox Grid.Column="1" Text="{Binding ConfigEditBuffer.Port, UpdateSourceTrigger=PropertyChanged}"
                                                                     materialDesign:HintAssist.Hint="Puerto" Margin="0,0,0,16"
                                                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                                                        </Grid>
                                                        <TextBox Text="{Binding ConfigEditBuffer.DatabaseName, UpdateSourceTrigger=PropertyChanged}"
                                                                 materialDesign:HintAssist.Hint="Nombre de la Base de Datos" Margin="0,0,0,16"
                                                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                                                        <TextBox Text="{Binding ConfigEditBuffer.Username, UpdateSourceTrigger=PropertyChanged}"
                                                                 materialDesign:HintAssist.Hint="Usuario" Margin="0,0,0,16"
                                                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                                                        <materialDesign:Card Background="#F5F7F9" Padding="8,4" UniformCornerRadius="4" Margin="0,0,0,16">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Campo de Texto Plano (Visible solo al presionar el ojo) -->
                                                                <TextBox Grid.Column="0" 
                                                                         materialDesign:HintAssist.Hint="Contraseña"
                                                                         Text="{Binding ConfigEditBuffer.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         BorderThickness="0" VerticalAlignment="Center">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ElementName=ShowPasswordBtn, Path=IsPressed}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>

                                                                <!-- Campo de Password (Oculto al presionar el ojo) -->
                                                                <PasswordBox Grid.Column="0" 
                                                                             materialDesign:HintAssist.Hint="Contraseña"
                                                                             x:Name="ConfigPasswordBox"
                                                                             helpers:PasswordBoxHelper.BindPassword="True"
                                                                             helpers:PasswordBoxHelper.BoundPassword="{Binding ConfigEditBuffer.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             BorderThickness="0" VerticalAlignment="Center">
                                                                    <PasswordBox.Style>
                                                                        <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignFloatingHintPasswordBox}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ElementName=ShowPasswordBtn, Path=IsPressed}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </PasswordBox.Style>
                                                                </PasswordBox>

                                                                <!-- Botón de Ojo -->
                                                                <Button Grid.Column="1" x:Name="ShowPasswordBtn"
                                                                        Style="{StaticResource MaterialDesignIconButton}"
                                                                        Width="32" Height="32" Padding="0"
                                                                        Foreground="{DynamicResource PrimaryBrush}"
                                                                        ToolTip="Mantener presionado para ver">
                                                                    <materialDesign:PackIcon Kind="Eye" Width="20" Height="20"/>
                                                                </Button>
                                                            </Grid>
                                                        </materialDesign:Card>
                                                        <CheckBox Content="Usar SSL Mode (Seguro)" 
                                                                  IsChecked="{Binding ConfigEditBuffer.SslMode}" Margin="0,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>

                                            <!-- TEST CONNECTION AREA -->
                                            <Border Grid.Row="4" Background="#F5F7F9" CornerRadius="8" Padding="16" Margin="0,20,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TestResultMessage, FallbackValue='No se ha probado la conexión'}" 
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding IsTestSuccessful, Converter={StaticResource StatusToBrushConverter}}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Command="{Binding TestConnectionCommand}"
                                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                                            Content="PROBAR CONEXIÓN" 
                                                            materialDesign:ButtonProgressAssist.IsIndeterminate="{Binding IsTestingConnection}"
                                                            materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsTestingConnection}"/>
                                                </Grid>
                                            </Border>

                                            <!-- FOOTER ACTIONS -->
                                            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                                                <Button Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" 
                                                        Style="{StaticResource MaterialDesignFlatButton}" 
                                                        Content="CANCELAR" Margin="0,0,8,0"/>
                                                <Button Command="{Binding SaveConfigurationCommand}" 
                                                        Style="{StaticResource MaterialDesignRaisedButton}" 
                                                        Content="GUARDAR CAMBIOS" 
                                                        Background="{DynamicResource PrimaryBrush}"
                                                        Foreground="White"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button.CommandParameter>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DatabaseSettings" Width="20" Height="20" Margin="0,0,12,0"/>
                                        <TextBlock Text="Bases de Datos"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </materialDesign:PopupBox>
                    </StackPanel>

                    <!-- DEVELOPER FOOTER -->
                    <Border Grid.Row="3" Background="#1A000000" Padding="24,20" BorderThickness="0,1,0,0" BorderBrush="#1AFFFFFF">
                        <StackPanel Opacity="0.8">
                            <TextBlock Text="DESARROLLO POR" FontSize="10" FontWeight="Bold" Foreground="#8A9BA8" Margin="0,0,0,12"/>
                            
                            <Button Command="{Binding OpenEmailCommand}" Style="{StaticResource MaterialDesignFlatButton}" 
                                    Padding="0" HorizontalContentAlignment="Left" Height="24" Margin="0,0,0,8"
                                    Foreground="White" ToolTip="Enviar Correo">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="EmailOutline" Width="16" Height="16" Opacity="0.7"/>
                                    <TextBlock Text="sr._irvin@hotmail.com" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding OpenLinkedInCommand}" Style="{StaticResource MaterialDesignFlatButton}" 
                                    Padding="0" HorizontalContentAlignment="Left" Height="24"
                                    Foreground="White" ToolTip="Ver Perfil de LinkedIn">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Linkedin" Width="16" Height="16" Opacity="0.7"/>
                                    <TextBlock Text="linkedin.com/in/sr-irvin" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:DrawerHost.LeftDrawerContent>

            <DockPanel Background="{DynamicResource BackgroundBrush}">
                <materialDesign:ColorZone Padding="8,16" materialDesign:ElevationAssist.Elevation="Dp2" 
                                          Mode="Standard" DockPanel.Dock="Top" Background="White">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <ToggleButton x:Name="MenuToggleButton" Style="{StaticResource MaterialDesignHamburgerToggleButton}"
                                          Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" FontSize="18" 
                                       Text="Orión - Sistema de Gestión" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <materialDesign:Chip Content="{Binding CurrentUserRole, StringFormat='Sesión: {0}', FallbackValue='Sesión: Usuario'}" 
                                                 Margin="8,0,16,0" 
                                                 IconBackground="{DynamicResource PrimaryBrush}"
                                                 IconForeground="White">
                                <materialDesign:Chip.Icon>
                                    <materialDesign:PackIcon Kind="Account" />
                                </materialDesign:Chip.Icon>
                            </materialDesign:Chip>
                        </StackPanel>
                    </DockPanel>
                </materialDesign:ColorZone>

                <Grid Margin="24">
                    <ContentControl Content="{Binding CurrentView}"/>
                </Grid>
            </DockPanel>
        </materialDesign:DrawerHost>
    </materialDesign:DialogHost>
</Window>
