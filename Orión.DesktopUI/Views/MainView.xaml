<Window x:Class="Orión.DesktopUI.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Orión.DesktopUI.Views"
        xmlns:converters="clr-namespace:Orión.DesktopUI.Converters"
        mc:Ignorable="d"
        Title="Orión - Gestor de Mantenimiento" Height="720" Width="1280"
        Icon="../Assets/Icono.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <materialDesign:DialogHost Identifier="MainDialogHost" SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}">
        <materialDesign:DrawerHost IsLeftDrawerOpen="{Binding ElementName=MenuToggleButton, Path=IsChecked}">
            <materialDesign:DrawerHost.LeftDrawerContent>
                <Grid Width="280">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00243A" Offset="0"/>
                            <GradientStop Color="#003153" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Menu -->
                        <RowDefinition Height="Auto"/> <!-- Settings -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <StackPanel Grid.Row="0" Margin="0,40,0,40">
                        <materialDesign:Card Width="90" Height="90" UniformCornerRadius="45" 
                                             Padding="0" Background="White" materialDesign:ElevationAssist.Elevation="Dp3"
                                             HorizontalAlignment="Center">
                            <Image Source="../Assets/Icono.PNG" Width="60" Height="60" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </materialDesign:Card>
                        <TextBlock Text="ORIÓN" HorizontalAlignment="Center" Margin="0,16,0,0" 
                                   FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="SISTEMA DE GESTIÓN" HorizontalAlignment="Center" 
                                   FontSize="10" Foreground="#A0A8AE" FontWeight="Light" Opacity="0.7"/>
                    </StackPanel>
                    
                    <!-- MAIN MENU -->
                    <ListBox Grid.Row="1" x:Name="DrawerListBox" Margin="0" 
                             SelectedIndex="0"
                             ItemContainerStyle="{StaticResource MaterialDesignNavigationListBoxItem}"
                             Style="{StaticResource MaterialDesignNavigationPrimaryListBox}"
                             Background="Transparent">
                        
                        <ListBoxItem Foreground="White" Height="48">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToDashboardCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" Margin="24,0,20,0" VerticalAlignment="Center" Width="24" Height="24" Opacity="0.9"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="15" FontWeight="Normal"/>
                            </StackPanel>
                        </ListBoxItem>
                        
                        <ListBoxItem Foreground="White" Height="48">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToMaquinariaCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Engine" Margin="24,0,20,0" VerticalAlignment="Center" Width="24" Height="24" Opacity="0.9"/>
                                <TextBlock Text="Maquinaria" VerticalAlignment="Center" FontSize="15" FontWeight="Normal"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Foreground="White" Height="48">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToTecnicosCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Margin="24,0,20,0" VerticalAlignment="Center" Width="24" Height="24" Opacity="0.9"/>
                                <TextBlock Text="Personal" VerticalAlignment="Center" FontSize="15" FontWeight="Normal"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Foreground="White" Height="48">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToSolicitudesCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="HammerWrench" Margin="24,0,20,0" VerticalAlignment="Center" Width="24" Height="24" Opacity="0.9"/>
                                <TextBlock Text="Solicitudes" VerticalAlignment="Center" FontSize="15" FontWeight="Normal"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Foreground="White" Height="48">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToProveedoresCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TruckDelivery" Margin="24,0,20,0" VerticalAlignment="Center" Width="24" Height="24" Opacity="0.9"/>
                                <TextBlock Text="Proveedores" VerticalAlignment="Center" FontSize="15" FontWeight="Normal"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Foreground="White" Height="48">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToReportesCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocument" Margin="24,0,20,0" VerticalAlignment="Center" Width="24" Height="24" Opacity="0.9"/>
                                <TextBlock Text="Reportes" VerticalAlignment="Center" FontSize="15" FontWeight="Normal"/>
                            </StackPanel>
                        </ListBoxItem>
                        
                        <ListBoxItem Foreground="White" Height="48" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBoxItem.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToUsuariosCommand}"/>
                            </ListBoxItem.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShieldAccount" Margin="24,0,20,0" VerticalAlignment="Center" Width="24" Height="24" Opacity="0.9"/>
                                <TextBlock Text="Usuarios" VerticalAlignment="Center" FontSize="15" FontWeight="Normal"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- SETTINGS SECTION -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,16">
                        <Separator Background="White" Margin="20,0,20,8" Opacity="0.15"/>
                        
                        <materialDesign:PopupBox Style="{DynamicResource MaterialDesignPopupBox}"
                                                PlacementMode="RightAndAlignTopEdges"
                                                UnfurlOrientation="Horizontal"
                                                ToolTip="Configuración y Sesión"
                                                Foreground="White"
                                                Margin="24,0,20,0"
                                                HorizontalAlignment="Left">
                            <materialDesign:PopupBox.ToggleContent>
                                <StackPanel Orientation="Horizontal" Height="48">
                                    <materialDesign:PackIcon Kind="SettingsOutline" Width="24" Height="24" VerticalAlignment="Center" Opacity="0.9"/>
                                    <TextBlock Text="Configuración" VerticalAlignment="Center" FontSize="15" Margin="20,0,0,0" FontWeight="Normal"/>
                                </StackPanel>
                            </materialDesign:PopupBox.ToggleContent>
                            
                            <StackPanel Width="220">
                                <TextBlock Text="CONFIGURACIÓN" Margin="16,12,16,8" FontSize="10" FontWeight="Bold" Opacity="0.6"/>
                                
                                <Button Command="{Binding LogoutCommand}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" Margin="0,0,12,0"/>
                                        <TextBlock Text="Cerrar sesión"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding SwitchAccountCommand}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountSwitch" Width="20" Height="20" Margin="0,0,12,0"/>
                                        <TextBlock Text="Switch Account"/>
                                    </StackPanel>
                                </Button>
                                
                                <Separator Margin="8,4"/>

                                <TextBlock Text="SISTEMA DE DATOS" Margin="16,4,16,8" FontSize="10" FontWeight="Bold" Opacity="0.6"/>

                                <Button Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}" 
                                        Style="{StaticResource MaterialDesignFlatButton}" 
                                        HorizontalContentAlignment="Left" Padding="16,8">
                                    <Button.CommandParameter>
                                        <Grid Width="450" Margin="16">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding CurrentDbProvider, StringFormat='INFORMACIÓN DE CONEXIÓN - {0}', Converter={StaticResource StringToUpperConverter}}" 
                                                       FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                                            
                                            <Separator Grid.Row="1" Background="{StaticResource PrimaryBrush}" Margin="0,0,0,16" Opacity="0.3"/>

                                            <StackPanel Grid.Row="2">
                                                <materialDesign:Card Background="#F5F7F9" Padding="16" UniformCornerRadius="8" Margin="0,0,0,16">
                                                    <StackPanel>
                                                        <TextBlock Text="CONNECTION STRING ACTUAL:" FontSize="10" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,8"/>
                                                        <TextBox Text="{Binding CurrentConnectionString, Mode=OneWay}" 
                                                                 IsReadOnly="True" TextWrapping="Wrap" 
                                                                 FontSize="11" FontFamily="Consolas" BorderThickness="0" Background="Transparent"/>
                                                    </StackPanel>
                                                </materialDesign:Card>

                                                <TextBlock Text="REQUISITOS Y DETALLES:" FontSize="10" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,8"/>
                                                
                                                <!-- Contenido condicional según proveedor -->
                                                <StackPanel Visibility="{Binding CurrentDbProvider, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Access'}">
                                                    <TextBlock Text="• Tipo: Microsoft Access Database (.accdb)" Margin="0,0,0,4"/>
                                                    <TextBlock Text="• Provider: Microsoft.ACE.OLEDB.12.0" Margin="0,0,0,4"/>
                                                    <TextBlock Text="• Ubicación: Carpeta de Documentos del usuario" Margin="0,0,0,4"/>
                                                    <TextBlock Text="• Requisito: Access Database Engine 2016+ (X64)" Foreground="#FF6F61" FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <StackPanel Visibility="{Binding CurrentDbProvider, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='PostgreSQL'}">
                                                    <TextBlock Text="• Tipo: PostgreSQL Relational Database" Margin="0,0,0,4"/>
                                                    <TextBlock Text="• Driver: Npgsql ADO.NET Data Provider" Margin="0,0,0,4"/>
                                                    <TextBlock Text="• Versión recomendada: 14 o superior" Margin="0,0,0,4"/>
                                                    <TextBlock Text="• Puerto por defecto: 5432" Margin="0,0,0,4"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                                <Button Command="{Binding CopyConnectionStringCommand}" 
                                                        Style="{StaticResource MaterialDesignOutlinedButton}" 
                                                        Content="COPIAR CONNECTION STRING" Margin="0,0,8,0" FontSize="11"/>
                                                <Button Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" 
                                                        Style="{StaticResource MaterialDesignFlatButton}" 
                                                        Content="CERRAR" Foreground="#FF6F61"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button.CommandParameter>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Database" Width="20" Height="20" Margin="0,0,12,0"/>
                                        <TextBlock Text="Bases de Datos"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </materialDesign:PopupBox>
                    </StackPanel>

                    <!-- DEVELOPER FOOTER -->
                    <Border Grid.Row="3" Background="#1A000000" Padding="24,20" BorderThickness="0,1,0,0" BorderBrush="#1AFFFFFF">
                        <StackPanel Opacity="0.8">
                            <TextBlock Text="DESARROLLO POR" FontSize="10" FontWeight="Bold" Foreground="#8A9BA8" Margin="0,0,0,12"/>
                            
                            <Button Command="{Binding OpenEmailCommand}" Style="{StaticResource MaterialDesignFlatButton}" 
                                    Padding="0" HorizontalContentAlignment="Left" Height="24" Margin="0,0,0,8"
                                    Foreground="White" ToolTip="Enviar Correo">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="EmailOutline" Width="16" Height="16" Opacity="0.7"/>
                                    <TextBlock Text="sr._irvin@hotmail.com" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding OpenLinkedInCommand}" Style="{StaticResource MaterialDesignFlatButton}" 
                                    Padding="0" HorizontalContentAlignment="Left" Height="24"
                                    Foreground="White" ToolTip="Ver Perfil de LinkedIn">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Linkedin" Width="16" Height="16" Opacity="0.7"/>
                                    <TextBlock Text="linkedin.com/in/sr-irvin" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </materialDesign:DrawerHost.LeftDrawerContent>

            <DockPanel Background="{DynamicResource BackgroundBrush}">
                <materialDesign:ColorZone Padding="8,16" materialDesign:ElevationAssist.Elevation="Dp2" 
                                          Mode="Standard" DockPanel.Dock="Top" Background="White">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <ToggleButton x:Name="MenuToggleButton" Style="{StaticResource MaterialDesignHamburgerToggleButton}"
                                          Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" FontSize="18" 
                                       Text="Orión - Sistema de Gestión" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <materialDesign:Chip Content="{Binding CurrentUserRole, StringFormat='Sesión: {0}', FallbackValue='Sesión: Usuario'}" 
                                                 Margin="8,0,16,0" 
                                                 IconBackground="{DynamicResource PrimaryBrush}"
                                                 IconForeground="White">
                                <materialDesign:Chip.Icon>
                                    <materialDesign:PackIcon Kind="Account" />
                                </materialDesign:Chip.Icon>
                            </materialDesign:Chip>
                        </StackPanel>
                    </DockPanel>
                </materialDesign:ColorZone>

                <Grid Margin="24">
                    <ContentControl Content="{Binding CurrentView}"/>
                </Grid>
            </DockPanel>
        </materialDesign:DrawerHost>
    </materialDesign:DialogHost>
</Window>
