<UserControl x:Class="Orión.DesktopUI.Views.TecnicoListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="GESTIÓN DE PERSONAL TÉCNICO" Style="{StaticResource MaterialDesignHeadline5TextBlock}" VerticalAlignment="Center"/>
            <Button Command="{Binding LoadTecnicosCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="16,0,0,0">
                <materialDesign:PackIcon Kind="Refresh"/>
            </Button>
            
            <TextBox Width="250" Margin="32,0,0,0"
                     materialDesign:HintAssist.Hint="Buscar técnico..."
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding LoadTecnicosCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Button Command="{Binding CreateTecnicoCommand}" 
                    Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="16,0,0,0" ToolTip="Registrar Nuevo Técnico">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountPlus" Margin="0,0,8,0"/>
                    <TextBlock Text="NUEVO"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" VerticalAlignment="Top" 
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Tecnicos}" SelectedItem="{Binding SelectedTecnico}" 
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Style="{StaticResource MaterialDesignDataGrid}"
                  materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID PERSONAL" Binding="{Binding IdPersonal}"/>
                <DataGridTextColumn Header="NOMBRE Y APELLIDO" Binding="{Binding NombreApellido}" Width="*"/>
                <DataGridTextColumn Header="ESPECIALIDAD" Binding="{Binding Especialidad}"/>
                <DataGridTextColumn Header="TURNO ASIGNADO" Binding="{Binding TurnoDescripcion}"/>
                <DataGridTextColumn Header="ESTADO" Binding="{Binding Activo, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Estado'}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Activo"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Activo}" Value="False">
                                    <Setter Property="Text" Value="Inactivo"/>
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="ACCIONES" Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding DataContext.EditTecnicoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        Style="{StaticResource MaterialDesignIconButton}" ToolTip="Editar">
                                    <materialDesign:PackIcon Kind="Edit"/>
                                </Button>
                                <Button Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        Style="{StaticResource MaterialDesignIconButton}" ToolTip="Cambiar Estado">
                                    <materialDesign:PackIcon Kind="{Binding Activo, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Icon'}">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="Delete"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                        <Setter Property="Kind" Value="Restore"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
