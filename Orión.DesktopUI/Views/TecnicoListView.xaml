<UserControl x:Class="Orión.DesktopUI.Views.TecnicoListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             Style="{StaticResource ViewEntranceAnimation}" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER CARD -->
        <materialDesign:Card Padding="16" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="AccountGroup" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="GESTIÓN DE PERSONAL TÉCNICO" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBox Width="250" Margin="0,0,16,0"
                             materialDesign:HintAssist.Hint="Buscar técnico..."
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoadTecnicosCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Command="{Binding LoadTecnicosCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" ToolTip="Actualizar">
                        <materialDesign:PackIcon Kind="Refresh"/>
                    </Button>

                    <Button Command="{Binding CreateTecnicoCommand}" 
                            Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource MaterialDesignRaisedButton}" Width="120" ToolTip="Registrar Nuevo Técnico">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountPlus" Margin="0,0,8,0"/>
                            <TextBlock Text="NUEVA"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- CONTENT CARD -->
        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Panel.ZIndex="1"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <DataGrid ItemsSource="{Binding Tecnicos}" SelectedItem="{Binding SelectedTecnico}" 
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID PERSONAL" Binding="{Binding IdPersonal}" Width="Auto"/>
                        <DataGridTextColumn Header="NOMBRE Y APELLIDO" Binding="{Binding NombreApellido}" Width="*"/>
                        <DataGridTextColumn Header="ESPECIALIDAD" Binding="{Binding Especialidad}" Width="Auto"/>
                        <DataGridTextColumn Header="TURNO ASIGNADO" Binding="{Binding TurnoDescripcion}" Width="Auto"/>
                        
                        <DataGridTemplateColumn Header="ESTADO" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:Chip Content="{Binding Activo, Converter={StaticResource BooleanToStatusConverter}}" 
                                                         Background="{Binding Activo, Converter={StaticResource StatusToBrushConverter}}" 
                                                         Foreground="White"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ACCIONES" Width="Auto" Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.EditTecnicoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                Style="{StaticResource MaterialDesignIconButton}" ToolTip="Editar" Width="30" Height="30">
                                            <materialDesign:PackIcon Kind="Edit" Width="18" Height="18"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                Style="{StaticResource MaterialDesignIconButton}" ToolTip="Cambiar Estado" Width="30" Height="30">
                                            <materialDesign:PackIcon Width="18" Height="18">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="Delete"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                <Setter Property="Kind" Value="Restore"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
