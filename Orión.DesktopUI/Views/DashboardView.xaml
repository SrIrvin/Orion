<UserControl x:Class="Orión.DesktopUI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             Style="{StaticResource ViewEntranceAnimation}"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <TextBlock Text="PANEL DE CONTROL" Style="{StaticResource MaterialDesignHeadline4TextBlock}" 
                       FontWeight="Black" Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock Text="Estado actual del sistema de mantenimiento" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" 
                       Foreground="{StaticResource TextSecondaryBrush}"/>

            <!-- BANNER DE SEGURIDAD -->
            <materialDesign:Card Background="#FFF4F3" BorderBrush="#FF6F61" BorderThickness="1" 
                                 Margin="0,16,0,0" Padding="16" UniformCornerRadius="8"
                                 Visibility="{Binding ShowSecurityWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <materialDesign:PackIcon Kind="ShieldAlert" Foreground="#FF6F61" Width="24" Height="24" 
                                             VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="⚠️ SEGURIDAD EN RIESGO: Contraseña por defecto detectada" 
                                   FontWeight="Bold" Foreground="#FF6F61"/>
                        <TextBlock Text="Está utilizando las credenciales de administrador predeterminadas. Se recomienda cambiar su contraseña ahora mismo por seguridad." 
                                   FontSize="12" Opacity="0.8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                Content="RECORDAR DESPUÉS" Command="{Binding DismissSecurityWarningCommand}"
                                Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}" 
                                Content="CAMBIAR AHORA" Command="{Binding NavigateToUserProfileCommand}"
                                Background="#FF6F61" BorderBrush="#FF6F61" Foreground="White"/>
                    </StackPanel>
                </DockPanel>
            </materialDesign:Card>
        </StackPanel>

        <!-- Tarjetas KPI -->
        <UniformGrid Grid.Row="1" Columns="3">
            <materialDesign:Card Margin="8" Padding="24" Background="White" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <materialDesign:PackIcon Kind="Engine" Width="32" Height="32" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding TotalMaquinaria}" FontSize="36" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="MAQUINARIA TOTAL" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="8" Padding="24" Background="White" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <materialDesign:PackIcon Kind="AccountGroup" Width="32" Height="32" Foreground="{StaticResource SecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalTecnicos}" FontSize="36" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="TÉCNICOS ACTIVOS" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="8" Padding="24" Background="White" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <materialDesign:PackIcon Kind="AlertCircle" Width="32" Height="32" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{Binding SolicitudesAbiertas}" FontSize="36" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock Text="SOLICITUDES ABIERTAS" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>

        <!-- Mapa de Calor de Actividad Global -->
        <materialDesign:Card Grid.Row="2" Margin="8,24,8,8" Padding="24" Background="White" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="INTENSIDAD DE FALLAS GLOBAL" Style="{StaticResource MaterialDesignHeadline6TextBlock}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="Resumen de reportes totales en los últimos 30 días" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" 
                                Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Command="{Binding NavigateToSolicitudesCommand}"
                                Content="VER DETALLE" Height="30" Padding="8,0"/>
                    </DockPanel>
                </StackPanel>

                <!-- Leyenda -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <TextBlock Text="Baja actividad" Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Rectangle Width="12" Height="12" Fill="#EBEDF0" Margin="2"/>
                    <Rectangle Width="12" Height="12" Fill="#FFF4D1" Margin="2"/>
                    <Rectangle Width="12" Height="12" Fill="#FFD082" Margin="2"/>
                    <Rectangle Width="12" Height="12" Fill="#FF8A65" Margin="2"/>
                    <Rectangle Width="12" Height="12" Fill="#E53935" Margin="2"/>
                    <TextBlock Text="Alta actividad" Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Etiquetas Días -->
                        <ColumnDefinition Width="*"/>    <!-- Scrollable Heatmap -->
                    </Grid.ColumnDefinitions>

                    <!-- Etiquetas fijas de Días -->
                    <StackPanel Grid.Column="0" Margin="0,25,12,0" VerticalAlignment="Top">
                        <TextBlock Text="Dom" Height="30" Margin="0,3" FontSize="10" VerticalAlignment="Center" Opacity="0.6"/>
                        <TextBlock Text="Lun" Height="30" Margin="0,3" FontSize="10" VerticalAlignment="Center" Opacity="0.6"/>
                        <TextBlock Text="Mar" Height="30" Margin="0,3" FontSize="10" VerticalAlignment="Center" Opacity="0.6"/>
                        <TextBlock Text="Mié" Height="30" Margin="0,3" FontSize="10" VerticalAlignment="Center" Opacity="0.6"/>
                        <TextBlock Text="Jue" Height="30" Margin="0,3" FontSize="10" VerticalAlignment="Center" Opacity="0.6"/>
                        <TextBlock Text="Vie" Height="30" Margin="0,3" FontSize="10" VerticalAlignment="Center" Opacity="0.6"/>
                        <TextBlock Text="Sáb" Height="30" Margin="0,3" FontSize="10" VerticalAlignment="Center" Opacity="0.6"/>
                    </StackPanel>

                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <!-- ItemsControl de COLUMNAS (Semanas) -->
                        <ItemsControl ItemsSource="{Binding GlobalHeatmapData}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,0">
                                        <!-- Encabezado de Fecha de la Semana -->
                                        <TextBlock Text="{Binding DateHeader}" FontSize="8" TextAlignment="Center" Opacity="0.5" FontWeight="Bold" Margin="0,0,0,8"/>
                                        
                                        <!-- ItemsControl de FILAS (Días de esa semana) -->
                                        <ItemsControl ItemsSource="{Binding Days}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.NavigateToSolicitudesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                            Padding="0" Margin="0,3" Width="30" Height="30">
                                                        <Border Width="28" Height="28" CornerRadius="4" Background="{Binding ColorLevel}">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FailureCount}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#444" 
                                                                           Visibility="{Binding FailureCount, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <ToolTipService.ToolTip>
                                                                    <ToolTip>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Date, StringFormat='Fecha: {0:dd/MM/yyyy}'}" FontWeight="Bold"/>
                                                                            <TextBlock Text="{Binding DayName, StringFormat='Día: {0}'}"/>
                                                                            <TextBlock Text="{Binding FailureCount, StringFormat='Fallas totales: {0}'}"/>
                                                                        </StackPanel>
                                                                    </ToolTip>
                                                                </ToolTipService.ToolTip>
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </materialDesign:Card>

        <!-- Mensaje de bienvenida/fondo y Marca de Agua -->
        <Grid Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,16,16">
            <StackPanel HorizontalAlignment="Right">
                <Image Source="../Assets/Icono.PNG" Width="120" Opacity="0.03" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                
                <!-- Watermark Producción -->
                <TextBlock Text="ORIÓN v1.0.0 stable" 
                           FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" 
                           Opacity="0.15" HorizontalAlignment="Right"
                           Visibility="{Binding DataContext.IsProduction, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Watermark Staging -->
                <StackPanel Orientation="Horizontal" Opacity="0.25" HorizontalAlignment="Right">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsProduction, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <materialDesign:PackIcon Kind="Flask" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="ORIÓN - DEMO BETA v1.0.0" 
                               FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" 
                               FontStyle="Italic"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
