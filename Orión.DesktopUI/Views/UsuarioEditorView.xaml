<UserControl x:Class="Orión.DesktopUI.Views.UsuarioEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             Width="400">
    <Border Background="{DynamicResource MaterialDesignPaper}" 
            CornerRadius="8" 
            Padding="24"
            materialDesign:ElevationAssist.Elevation="Dp8">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,24"/>
            
            <TextBox materialDesign:HintAssist.Hint="Nombre de Usuario" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsNew}"
                     Margin="0,0,0,16"/>

            <TextBox materialDesign:HintAssist.Hint="Correo Electrónico" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,16"/>

            <PasswordBox materialDesign:HintAssist.Hint="Contraseña" 
                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                         Visibility="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Name="PasswordBox"
                         Margin="0,0,0,16"/>

            <ComboBox materialDesign:HintAssist.Hint="Rol del Sistema"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                      SelectedValue="{Binding Rol}"
                      Margin="0,0,0,24">
                <system:String>Admin</system:String>
                <system:String>Tecnico</system:String>
                <system:String>Operador</system:String>
            </ComboBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Content="CANCELAR"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                    <Button.CommandParameter>
                        <Binding RelativeSource="{RelativeSource Self}" />
                    </Button.CommandParameter>
                </Button>
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Content="GUARDAR"
                        Click="Save_Click"
                        Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
