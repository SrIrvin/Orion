<UserControl x:Class="Orión.DesktopUI.Views.SolicitudListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             Style="{StaticResource ViewEntranceAnimation}" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER CARD -->
        <materialDesign:Card Padding="16" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <materialDesign:PackIcon Kind="HammerWrench" Width="32" Height="32" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="CONTROL DE SOLICITUDES" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBox Width="250" Margin="0,0,16,0"
                             materialDesign:HintAssist.Hint="Buscar solicitud..."
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoadDataCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Command="{Binding LoadDataCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" ToolTip="Actualizar">
                        <materialDesign:PackIcon Kind="Refresh"/>
                    </Button>

                    <Button Command="{Binding ShowFormCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" Width="150" ToolTip="Registrar Nueva Solicitud">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0"/>
                            <TextBlock Text="NUEVA SS"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- FORMULARIO (Condicional) -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,24" Padding="24"
                             Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                             materialDesign:ElevationAssist.Elevation="Dp4">
            <StackPanel>
                <TextBlock Text="REGISTRAR NUEVA FALLA" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,20" Foreground="{StaticResource PrimaryBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <ComboBox materialDesign:HintAssist.Hint="Seleccionar Máquina"
                                  ItemsSource="{Binding Maquinas}"
                                  SelectedValue="{Binding SelectedMaquinariaId}"
                                  SelectedValuePath="IdMaquinaria"
                                  DisplayMemberPath="NombreMaquina"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <ComboBox materialDesign:HintAssist.Hint="Tipo Mantenimiento"
                                  ItemsSource="{Binding TiposMantenimiento}"
                                  SelectedValue="{Binding SelectedTipoManttoId}"
                                  SelectedValuePath="IdTipoMantto"
                                  DisplayMemberPath="DescripcionTipo"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBox materialDesign:HintAssist.Hint="Descripción Detallada de la Falla"
                                 Text="{Binding DescripcionFalla}"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="CANCELAR" Command="{Binding HideFormCommand}" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,12,0"/>
                    <Button Content="GUARDAR SOLICITUD" Command="{Binding SaveSolicitudCommand}" Style="{StaticResource MaterialDesignRaisedButton}"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- CONTENT CARD -->
        <materialDesign:Card Grid.Row="2" materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Panel.ZIndex="1"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <DataGrid ItemsSource="{Binding Solicitudes}" AutoGenerateColumns="False" IsReadOnly="True"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdSS}" Width="Auto"/>
                        <DataGridTextColumn Header="MÁQUINA" Binding="{Binding NombreMaquinaria}" Width="Auto"/>
                        <DataGridTextColumn Header="FALLA" Binding="{Binding DescripcionFalla}" Width="*"/>
                        <DataGridTextColumn Header="APERTURA" Binding="{Binding FechaApertura, StringFormat=g}" Width="Auto"/>
                        <DataGridTextColumn Header="TIPO" Binding="{Binding TipoMantenimientoDescripcion}" Width="Auto"/>
                        <DataGridTextColumn Header="TÉCNICO" Binding="{Binding TecnicoNombre}" Width="Auto"/>
                        
                        <DataGridTemplateColumn Header="ESTADO" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:Chip Content="{Binding EstadoDescripcion}" 
                                                         Background="{StaticResource PrimaryBrush}" 
                                                         Foreground="White"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ACCIONES" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="PDF" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                            Command="{Binding DataContext.GenerateReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Height="25" Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
