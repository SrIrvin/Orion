<UserControl x:Class="Orión.DesktopUI.Views.ComponenteEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             Style="{StaticResource ViewEntranceAnimation}" 
             Width="450">
    <Border Background="{DynamicResource MaterialDesignPaper}" 
            CornerRadius="8" 
            Padding="24"
            materialDesign:ElevationAssist.Elevation="Dp8">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,24"/>
            
            <TextBox materialDesign:HintAssist.Hint="ID Componente" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Text="{Binding IdComponente, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsNew}"
                     Margin="0,0,0,16"/>

            <TextBox materialDesign:HintAssist.Hint="Nombre del Componente" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Text="{Binding NombreComponente, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,16"/>

            <TextBox materialDesign:HintAssist.Hint="Marca" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Text="{Binding Marca, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,16"/>

            <TextBox materialDesign:HintAssist.Hint="Número de Serie" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Text="{Binding NumeroSerie, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,16"/>

            <TextBox materialDesign:HintAssist.Hint="Especificaciones Técnicas" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Text="{Binding EspecificacionesTecnicas, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,16"/>

            <DatePicker materialDesign:HintAssist.Hint="Fecha Último Cambio" 
                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                        SelectedDate="{Binding FechaUltimoCambio}"
                        Margin="0,0,0,16"/>

            <ComboBox materialDesign:HintAssist.Hint="Tipo de Componente"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                      ItemsSource="{Binding TiposComponentes}"
                      DisplayMemberPath="NombreTipo"
                      SelectedValuePath="IdTipoComponente"
                      SelectedValue="{Binding IdTipoComponente}"
                      Margin="0,0,0,16"/>

            <ComboBox materialDesign:HintAssist.Hint="Estado Actual"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                      ItemsSource="{Binding EstadosComponentes}"
                      DisplayMemberPath="DescripcionEstado"
                      SelectedValuePath="IdEstado"
                      SelectedValue="{Binding IdEstado}"
                      Margin="0,0,0,16"/>

            <ComboBox materialDesign:HintAssist.Hint="Proveedor (Seleccione o escriba nuevo)" 
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                      IsEditable="True"
                      ItemsSource="{Binding Proveedores}"
                      DisplayMemberPath="Nombre"
                      Text="{Binding NombreProveedor, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,0,0,24"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Content="CANCELAR"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                    <Button.CommandParameter>
                        <Binding RelativeSource="{RelativeSource Self}" />
                    </Button.CommandParameter>
                </Button>
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Content="GUARDAR"
                        Command="{Binding SaveCommand}"
                        Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

